# Konfiguration für ts-advertise-routes und ts-watchdog (wird von setup.sh nicht überschrieben)

# Feste Routen statt automatischer Erkennung, kommagetrennt.
# Beispiel bei Subnetz-Kollision mit dem Heimnetz: nur das KNX-Interface anbieten
#   ROUTES_OVERRIDE="192.168.178.50/32"
ROUTES_OVERRIDE=""

# Zusätzlich anzubietende Routen, kommagetrennt
EXTRA_ROUTES=""

# 4via6: Site-ID (0–65535). Gesetzt = das erkannte IPv4-Subnetz wird unter
# fd7a:115c:a1e0:b1a:0:<ID>:… angeboten statt direkt. Siehe README.
VIA_SITE_ID=""

# Auch nicht-private Subnetze anbieten (yes/no)
ALLOW_NON_PRIVATE="no"

# Neustart nach so vielen Minuten ohne Verbindung, 0 = nie
WATCHDOG_REBOOT_AFTER_MIN="30"

# KNXnet/IP relay on the Tailscale address (ts-knx-relay), for interfaces that do not
# support route-back: "auto" = find the interface by multicast search, an IP = use that
# interface, empty = relay off. Clients then use the router's Tailscale IP as gateway.
KNX_RELAY_TARGET="auto"

# Bus log of ts-knx-relay (see README): "yes" or "no". While on, the relay holds the
# interface's tunnel whenever no client of yours uses it.
KNX_LOG="yes"
# Delete days older than this; size cap of all log files; disk space to keep free (MB)
KNX_LOG_KEEP_DAYS="90"
KNX_LOG_MAX_MB="2000"
KNX_LOG_MIN_FREE_MB="2000"
