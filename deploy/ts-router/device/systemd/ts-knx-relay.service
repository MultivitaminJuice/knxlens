[Unit]
Description=KNXnet/IP relay on the Tailscale address (for interfaces without route-back)
After=tailscaled.service network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=-/etc/default/ts-router
ExecStart=/usr/local/sbin/ts-knx-relay
# Exit 0 means "disabled by configuration" and stays stopped; crashes are restarted.
Restart=on-failure
RestartSec=5
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Bus log in /var/lib/ts-knx-relay; the router must keep running whatever the relay does.
StateDirectory=ts-knx-relay
MemoryMax=96M
CPUQuota=50%
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
LogRateLimitIntervalSec=60
LogRateLimitBurst=30
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
